{
  "name": "@nimble-api/oidc",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "OAuth 2.0 / OIDC client with PKCE for nimble-api",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "ISC",
  "author": "qayrup",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nimble-api/api-service": "*"
  },
  "peerDependenciesMeta": {
    "@nimble-api/api-service": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nimble-api/api-service": "*",
    "tsup": "^8.5.0",
    "typescript": "5.9"
  }
}
