{
  "name": "@nimble-api/node-adapter",
  "version": "1.0.5",
  "publishConfig": {
    "access": "public"
  },
  "description": "Node.js http/https adapter for @nimble-api/api-service — keepAlive, proxy, redirects, stream, decompress, cookie jar",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/qayrup/nimble-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/qayrup/nimble-api.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "ISC",
  "author": "qayrup",
  "keywords": [
    "qayrup",
    "nimble-api",
    "node-adapter",
    "http",
    "https",
    "adapter"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nimble-api/api-service": "*"
  },
  "devDependencies": {
    "@nimble-api/api-service": "*",
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "typescript": "5.9"
  }
}
