{
  "name": "@nimble-api/sse-service",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Server-Sent Events client for nimble-api",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "ISC",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9"
  }
}
