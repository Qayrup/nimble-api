{
  "name": "qayrup-npm",
  "private": true,
  "license": "ISC",
  "homepage": "https://github.com/qayrup/qayrup-npm",
  "repository": {
    "type": "git",
    "url": "https://github.com/qayrup/qayrup-npm.git"
  },
  "engines": {
    "node": ">=14"
  },
  "workspaces": [
    "api-service",
    "eventhub"
  ],
  "scripts": {
    "build": "npm run build -w qayrup-eventhub && npm run build -w qayrup-api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "clean": "npm run clean --workspaces",
    "clean:root": "rimraf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
