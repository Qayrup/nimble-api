{
  "name": "nimble-api",
  "private": true,
  "license": "ISC",
  "homepage": "https://github.com/qayrup/nimble-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/qayrup/nimble-api.git"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "api-service",
    "api-extend",
    "eventhub",
    "node-adapter",
    "sse-service",
    "oidc"
  ],
  "scripts": {
    "build": "npm run build -w @nimble-api/eventhub && npm run build -w @nimble-api/api-service && npm run build -w @nimble-api/api-extend && npm run build -w @nimble-api/sse-service && npm run build -w @nimble-api/node-adapter && npm run build -w @nimble-api/oidc",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "clean": "npm run clean --workspaces",
    "clean:root": "rimraf node_modules",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "publish:verdaccio": "node scripts/publish-verdaccio.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "5.9",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.8"
  },
  "volta": {
    "node": "22.23.1"
  }
}
